# backend/.env.example - Example environment variables for WorkSphere AI backend

DEBUG=false
ENVIRONMENT=production
AUTO_INIT_DB=false

# PostgreSQL database connection string for production
DATABASE_URL=postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Redis for token blacklist, rate limiting, and session telemetry
REDIS_URL=redis://<redis_host>:6379/0
REDIS_CACHE_TTL=3600

# JWT security
SECRET_KEY=<very-long-random-secret>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Host and CORS configuration
ALLOWED_HOSTS=<your-backend-hostname>.onrender.com
CORS_ORIGINS=https://<your-backend-hostname>.onrender.com

# Monitoring and error tracking (optional)
SENTRY_DSN=

# AWS optional storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=optiwork-uploads
AWS_S3_DOMAIN=s3.amazonaws.com

# SMTP optional email sending
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@optiwork.ai
